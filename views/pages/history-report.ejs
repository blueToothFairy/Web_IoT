<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>History Report</title>
    <link rel="stylesheet" href="/css/history-report.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <button class="goback-btn">Go Back</button>
            <button class="logout-btn">Log Out</button>
        </div>
        <div class="chart-grid">
            <div class="chart" id="Humidity">Chart</div>
            <div class="chart" id="Temperature">Chart</div>
            <div class="chart" id="Gas">Chart</div>
            <div class="chart" id="Dust">Chart</div>
        </div>
        <button class="export-btn">Export</button>
    </div>
</body>
</html>