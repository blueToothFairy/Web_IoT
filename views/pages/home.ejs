<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Home</title>
    <link rel="stylesheet" href="/css/home.css">
</head>

<body>
    <div class="header">
        <a href="/logout"><button class="logout-btn">Log Out</button></a>
    </div>
    <div class="main-status">
        <div>
            <div class="detail" id="detail-toggle">
                <span class="arrow">&#9660;</span>
                Detail
            </div>
            <div id="detail-content" style="display:none; margin-left: 20px;">
                <p>Temperature: <span id="temp-value">--</span> °C</p>
                <p>Humidity: <span id="humidity-value">--</span> %</p>
                <p>Dust: <span id="dust-value">--</span> µg/m³</p>
                <p>Gas: <span id="gas-value">--</span> ppm</p>
            </div>
        </div>
        <div class="status-circle">
            Safe
        </div>
        <div class="datetime">
            <span class="clock" id="clock"></span><br>
            <span class="date" id="date"></span>
        </div>
    </div>
    <div class="features-title">Features</div>
    <div class="features-grid">
        <a href="/threshold"><button class="feature-btn">Threshold Setting</button></a>
        <button id="testAlertBtn" class="feature-btn" onclick="testAlert()">Test Alert</button>
        <div class="silent-mode">
            Silent Mode
            <label class="switch">
                <input id="silent-mode-toggle" type="checkbox" unchecked>
                <span class="slider"></span>
            </label>
        </div>
        <a href="/chart"><button class="feature-btn">History Report</button></a>
        <button class="feature-btn" onclick="requestInstantData()">Get Instant Data</button>
        <a href="/scheduler"><button class="feature-btn">Scheduler</button></a>
    </div>
    <div class="chatbot">
        <div class="chatbot-btn">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="chatbot-label">Chat with<br>bot</div>
    </div>

    <script defer src="/js/home.js"></script>

</body>

</html>