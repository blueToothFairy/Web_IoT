<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Home</title>
    <link rel="stylesheet" href="/css/home.css">
</head>
<body>
    <div class="header">
        <button class="logout-btn">Log Out</button>
    </div>
    <div class="main-status">
        <div>
            <div class="detail">
                <span class="arrow">&#9660;</span>
                Detail
            </div>
        </div>
        <div class="status-circle">
            Safe
        </div>
        <div class="datetime">
            hh/mm/ss<br>
            mm/dd/yyyy
        </div>
    </div>
    <div class="features-title">Features</div>
    <div class="features-grid">
        <button class="feature-btn">Threshold Setting</button>
        <button class="feature-btn">Test Alert</button>
        <div class="silent-mode">
            Silent Mode
            <label class="switch">
                <input type="checkbox" checked>
                <span class="slider"></span>
            </label>
        </div>
        <button class="feature-btn">History Report</button>
        <button class="feature-btn">Get Instant Data</button>
        <button class="feature-btn">Scheduler</button>
    </div>
    <div class="chatbot">
        <div class="chatbot-btn">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="chatbot-label">Chat with<br>bot</div>
    </div>
</body>
</html>