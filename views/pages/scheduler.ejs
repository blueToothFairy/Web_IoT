<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scheduler</title>
    <link rel="stylesheet" href="/css/scheduler.css">
</head>

<body>
    <div class="container">
        <div class="header">
            <a href="/"><button class="home-btn">Home</button></a>
            <a href="/logout"><button class="logout-btn">Log Out</button></a>
        </div>
        <div class="title">Scheduler</div>
        <form class="scheduler-form">
            <div class="section">
                <div class="section-title">Interval between measurements</div>
                <div class="row">
                    <input id="interval-value" type="number" class="input-number" value="5" min="1" max="60">
                    <select id="interval-unit" class="input-select">
                        <option value="min">min</option>
                        <option value="hour">hour</option>
                    </select>
                </div>
            </div>
            <div class="section">
                <div class="section-title">Measure during specific time range</div>
                <div class="row label-row">
                    <div class="label-left">Start</div>
                </div>
                <div class="row">
                    <input type="number" class="input-number" value="5" min="1" max="12">
                    <select class="input-select">
                        <option value="AM">AM</option>
                        <option value="PM">PM</option>
                    </select>
                </div>
                <div class="row label-row">
                    <div class="label-left">End</div>
                </div>
                <div class="row">
                    <input type="number" class="input-number" value="5" min="1" max="12">
                    <select class="input-select">
                        <option value="AM">AM</option>
                        <option value="PM">PM</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
    <script>
        async function loadIntervalFromServer() {
            try {
                const res = await fetch('/get-interval');
                const { value, unit } = await res.json();
                document.getElementById('interval-value').value = value;
                document.getElementById('interval-unit').value = unit;
            } catch (err) {
                console.error('Failed to load interval:', err);
            }
        }

        async function saveIntervalToServer() {
            const value = parseInt(document.getElementById('interval-value').value, 10);
            const unit = document.getElementById('interval-unit').value;

            try {
                await fetch('/set-interval', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ value, unit })
                });
                alert('Interval saved!');
            } catch (err) {
                console.error('Failed to save interval:', err);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadIntervalFromServer();
            document.getElementById('interval-value').addEventListener('change', saveIntervalToServer);
            document.getElementById('interval-unit').addEventListener('change', saveIntervalToServer);
        });
    </script>


</body>

</html>