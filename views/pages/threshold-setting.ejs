<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Threshold Setting</title>
    <link rel="stylesheet" href="/css/threshold-setting.css">
</head>

<body>
    <div class="container">
        <div class="header">
            <a href="/"><button class="home-btn">Home</button></a>
            <a href="/logout"><button class="logout-btn">Log Out</button></a>
        </div>
        <div class="title">Threshold Setting</div>
        <div class="chart-grid">
            <div class="input">
                <label for="gas">Gas(ppm)</label>
                <input type="number" id="gas" value="800" min="500" max="5000">
            </div>
            <div class="input">
                <label for="dust">Dust(µg/m³)</label>
                <input type="number" id="dust" value="100" min="0" max="1000">
            </div>
            <div class="input">
                <label for="temperature">Temperature(°C)</label>
                <input type="number" id="temperature" value="32" min="16" max="40">
            </div>
            <div class="input">
                <label for="humidity">Humidity(%)</label>
                <input type="number" id="humidity" value="70" min="35" max="80">
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Load thresholds from server
            fetch('/thresholds')
                .then(res => res.json())
                .then(data => {
                    document.getElementById('gas').value = data.gas;
                    document.getElementById('dust').value = data.dust;
                    document.getElementById('temperature').value = data.temperature;
                    document.getElementById('humidity').value = data.humidity;
                });

            // Save thresholds when input changes
            document.querySelectorAll('.input input').forEach(input => {
                input.addEventListener('change', () => {
                    const payload = {
                        [input.id]: Number(input.value)
                    };
                    fetch('/thresholds', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                });
            });
        });
    </script>
</body>

</html>