<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Threshold Setting</title>
    <link rel="stylesheet" href="/css/threshold-setting.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <button class="goback-btn">Go Back</button>
            <button class="logout-btn">Log Out</button>
        </div>
        <div class="title">Threshold Setting</div>
        <div class="chart-grid">
            <div class="input">
                <label for="smoke">Smoke</label>
                <input type="number" id="smoke" value="100" min="0" max="1000">
            </div>
            <div class="input">
                <label for="dust">Dust</label>
                <input type="number" id="dust" value="100" min="0" max="1000">
            </div>
            <div class="input">
                <label for="temperature">Temperature</label>
                <input type="number" id="temperature" value="100" min="0" max="1000">
            </div>
            <div class="input">
                <label for="humidity">Humidity</label>
                <input type="number" id="humidity" value="100" min="0" max="1000">
            </div>
        </div>
    </div>
</body>
</html>